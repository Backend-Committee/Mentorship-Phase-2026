  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const payload = JSON.parse(pm.request.body.raw);",
                  "    pm.environment.set('username', payload.username);",
                  "    pm.environment.set('email', payload.email);",
                  "    pm.environment.set('password', payload.password);",
                  "    if (pm.response.json().access) { pm.environment.set('access_token', pm.response.json().access); }",
                  "    if (pm.response.json().refresh) { pm.environment.set('refresh_token', pm.response.json().refresh); }",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser{{$timestamp}}\",\n  \"email\": \"test{{$timestamp}}@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returned 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('access_token', pm.response.json().access);",
                  "    pm.environment.set('refresh_token', pm.response.json().refresh);",
                  "    pm.environment.set('panel_id', pm.response.json().panel_id);",
                  "    pm.environment.set('user_id', pm.response.json().user_id);",
                  "} else {",
                  "    console.log('Login failed body:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"panel_id\": \"{{panel_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
