    "online_results": false
}


### #Delete Laboratory by ID
DELETE {{base_url}}/api/facilities/laboratories/{{facilities.lab_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #List All Addresses
GET {{base_url}}/api/facilities/addresses/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Create New Address for a Facility
POST {{base_url}}/api/facilities/addresses/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "facility": {{facilities.facility_id}},
    "governorate": "Cairo",
    "city": "Nasr City",
    "street": "Tayaran Street",
    "latitude": 30.0561,
    "longitude": 31.3301
}

# save the address id into variable: {{facilities.address_id}}

--{%
  local body = ctx.json_body()
  ctx.set("facilities.address_id", body.id)
--%}


### #Get Address Detail by ID
GET {{base_url}}/api/facilities/addresses/{{facilities.address_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Update Address by ID
PUT {{base_url}}/api/facilities/addresses/{{facilities.address_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "facility": {{facilities.facility_id}},
    "governorate": "Giza",
    "city": "Dokki",
    "street": "Nile Street",
    "latitude": 30.0478,
    "longitude": 31.2065
}


### #Partial Update Address by ID
PATCH {{base_url}}/api/facilities/addresses/{{facilities.address_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "street": "Updated Street Name"
}


### #Delete Address by ID
DELETE {{base_url}}/api/facilities/addresses/{{facilities.address_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json
