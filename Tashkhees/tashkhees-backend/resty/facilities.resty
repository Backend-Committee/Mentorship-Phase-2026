# ============================================================
# Facilities API Tests — Clinics, Laboratories, Facilities & Addresses
# Base URL and tokens are defined as variables below.
# Run auth.resty first to populate the token variables.
# ============================================================

@base_url=http://localhost:8000


### #List All Facilities
GET {{base_url}}/api/facilities/facilities/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Create New Facility
POST {{base_url}}/api/facilities/facilities/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "name": "General Medical Center",
    "description": "A full-service medical facility.",
    "phone": "+1234567890",
    "email": "info@generalmed.com",
    "website": "https://generalmed.com",
    "opening_time": "08:00:00",
    "closing_time": "18:00:00",
    "is_active": true
}

# save the facility id into variable: {{facilities.facility_id}}

--{%
  local body = ctx.json_body()
  ctx.set("facilities.facility_id", body.id)
--%}


### #Get Facility Detail by ID
GET {{base_url}}/api/facilities/facilities/{{facilities.facility_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Update Facility by ID
PUT {{base_url}}/api/facilities/facilities/{{facilities.facility_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "name": "Updated General Medical Center",
    "description": "Updated description.",
    "phone": "+1234567890",
    "email": "info@generalmed.com",
    "website": "https://generalmed.com",
    "opening_time": "08:00:00",
    "closing_time": "20:00:00",
    "is_active": true
}


### #Partial Update Facility by ID
PATCH {{base_url}}/api/facilities/facilities/{{facilities.facility_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "phone": "+9876543210"
}


### #Delete Facility by ID
DELETE {{base_url}}/api/facilities/facilities/{{facilities.facility_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #List All Clinics
GET {{base_url}}/api/facilities/clinics/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Create New Clinic
POST {{base_url}}/api/facilities/clinics/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "name": "Cardiology Clinic",
    "description": "Specialized heart care clinic.",
    "phone": "+1112223333",
    "email": "heart@clinic.com",
    "website": "https://cardioclinic.com",
    "opening_time": "09:00:00",
    "closing_time": "17:00:00",
    "is_active": true,
    "specialty": "Cardiology",
    "consultation_fee": "150.00",
    "emergency_services": true,
    "appointment_required": true
}

# save the clinic id into variable: {{facilities.clinic_id}}

--{%
  local body = ctx.json_body()
  ctx.set("facilities.clinic_id", body.id)
--%}


### #Get Clinic Detail by ID
GET {{base_url}}/api/facilities/clinics/{{facilities.clinic_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


### #Update Clinic by ID
PUT {{base_url}}/api/facilities/clinics/{{facilities.clinic_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "name": "Advanced Cardiology Clinic",
    "description": "Updated heart care clinic.",
    "phone": "+1112223333",
    "email": "heart@clinic.com",
    "website": "https://cardioclinic.com",
    "opening_time": "09:00:00",
    "closing_time": "17:00:00",
    "is_active": true,
    "specialty": "Cardiology",
    "consultation_fee": "200.00",
    "emergency_services": true,
    "appointment_required": false
}


### #Partial Update Clinic by ID
PATCH {{base_url}}/api/facilities/clinics/{{facilities.clinic_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "consultation_fee": "175.00"
}


### #Delete Clinic by ID
DELETE {{base_url}}/api/facilities/clinics/{{facilities.clinic_id}}/
Authorization: Bearer {{auth.access_token}}
Content-Type: application/json


