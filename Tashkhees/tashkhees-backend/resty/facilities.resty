Authorization: Bearer {{auth.access_token}}
Content-Type: application/json

{
    "name": "Central Diagnostic Lab",
    "description": "Full diagnostic laboratory services.",
    "phone": "+4445556666",
    "email": "lab@central.com",
    "website": "https://centrallab.com",
    "opening_time": "07:00:00",
    "closing_time": "19:00:00",
    "is_active": true,
    "home_sample_collection": true,
    "online_results": true
}

