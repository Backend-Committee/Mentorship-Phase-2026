Content-Disposition: form-data; name="receiver"

2
------WebKitFormBoundary7MA4YWxkTrZu0gW--

--{%
  local body = ctx.json_body()
  ctx.set("files.upload_id", body.id)
  ctx.set("files.file_id", body.file)
--%}


